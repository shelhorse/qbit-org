[Unit]
Description=Recover completed qBittorrent books left in staging
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Match the PUID/PGID used by the qBittorrent container so directories and
# persistent log files remain writable by completion-hook processes.
ExecStart=/usr/bin/docker exec --user 1000:1000 qbittorrent python3 /organizer/organizer.py --config /organizer/config.json --scan-staging

# Do not allow a hung API request or storage move to hold the timer forever.
TimeoutStartSec=15m
