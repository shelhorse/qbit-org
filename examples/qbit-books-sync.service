[Unit]
Description=Mirror organized fiction and nonfiction EPUBs with rclone
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mo
Group=mo
ExecStart=/usr/bin/python3 /data/docker/qbittorrent/organizer/sync_books.py --config /data/docker/qbittorrent/organizer/sync.json
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
