[Unit]
Description=Mirror organized %i EPUBs with rclone
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# REQUIRED: replace [user] with the host account that owns the download tree
# before installing or enabling this unit.
User=[user]
Group=[user]
ExecStart=/usr/bin/python3 /data/docker/qbittorrent/organizer/sync_books.py --config /data/docker/qbittorrent/organizer/sync.json --job %i
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
